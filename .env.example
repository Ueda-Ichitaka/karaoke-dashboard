####################################################################
#  Copy this file to .env and fill in the values.
#  Do NOT commit .env — it is git-ignored.
#
#  IMPORTANT — .env value rules (docker compose / Portainer):
#    * Do NOT wrap values in quotes.
#    * Avoid  $  #  and leading/trailing spaces in a value — compose treats
#      `$` as a variable and (space)`#` as a comment.
#    * Safest is to generate secrets as hex:  openssl rand -hex 32
#    * The app URL-encodes POSTGRES_PASSWORD, so @ : / % etc. in it are fine
#      as long as they survive the .env rules above.
####################################################################

# --- Database (used by both containers) ---------------------------
POSTGRES_USER=karaoke
POSTGRES_DB=karaoke
# Generate with:  openssl rand -hex 24
POSTGRES_PASSWORD=change-me-postgres

# --- Web app -----------------------------------------------------
# Session signing key. MUST be long and random. Generate with:  openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-value

# Set to false ONLY if you reach the app over plain http:// (no reverse proxy / TLS).
# Leave true when behind Synology reverse proxy or any HTTPS.
SESSION_COOKIE_SECURE=true

# Host port the dashboard is published on (http://NAS-IP:PORT).
WEB_PORT=9713

# Timezone for timestamps shown in the admin tables.
TZ=Europe/Berlin

APP_TITLE=Karaoke Dashboard


# --- First-run admin account -----------------------------------
# Created automatically the first time the app starts (only if it does not exist).
# After first login you can change the password and manage users in the app.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
